generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URLs are in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  slug           String              @unique
  tier           String              @default("BASIC")
  country        String              @default("KE")
  isActive       Boolean             @default(true) @map("is_active")
  settings       Json                @default("{}")
  apiKeyHash     String?             @map("api_key_hash")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  entities            Entity[]
  items               Item[]
  inventoryContainers  InventoryContainer[]
  moneyMovements      MoneyMovement[]
  payments       Payment[]
  integrations   TenantIntegration[]
  transactions   Transaction[]
  users          User[]
  accounts           Account[]
  transactionReasons TransactionReason[]
  proofs             Proof[]
  notes              Note[]

  @@map("tenants")
}

model Note {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  aboutType   String   @map("about_type") // INVOICE, SUPPLY, etc.
  aboutId     String?  @map("about_id") @db.Uuid
  content     String?
  context     Json     @default("{}")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id, aboutType])
  @@index([tenantId, aboutType])
  @@map("notes")
}

model Entity {
  id                       String        @id @default(uuid()) @db.Uuid
  tenantId                 String        @map("tenant_id") @db.Uuid
  name                     String        @map("display_name")
  phone                    String?       @map("phone_number")
  email                    String?
  metadata                 Json          @default("{}")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId          String        @map("created_by_user_id") @db.Uuid
  entityType               EntityType    @default(CUSTOMER)
  business_registration    String?
  business_scale           String?
  registration_number      String?
  creditLimit              Decimal?      @map("credit_limit")
  paymentTerms             Int?          @map("payment_terms")
  trustScore               Int?          @map("trust_score")
  preferred_contact_method String?
  language_preference      String?
  location_notes           String?
  systemTags               String        @map("system_tags")
  customTags               String        @map("custom_tags")
  business_context         Json          @default("{}")
  createdBy                User          @relation("EntityCreator", fields: [createdByUserId], references: [id])
  tenant                   Tenant        @relation(fields: [tenantId], references: [id])
  transactions             Transaction[] @relation("TransactionEntity")
  assignedContainers       InventoryContainer[]

  @@unique([tenantId, phone])
  @@index([tenantId, entityType])
  @@map("entities")
}

model Transaction {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  // Universal Truth fields
  fromAccountId         String?              @map("from_account_id") @db.Uuid
  toAccountId           String?              @map("to_account_id") @db.Uuid
  reasonId              String?              @map("reason_id") @db.Uuid
  notes                 String?
  date                  DateTime             @default(now()) @db.Timestamptz(6)
  reversalId            String?              @map("reversal_id") @db.Uuid
  // Legacy fields (for backward compatibility)
  entityId              String?              @map("entity_id") @db.Uuid
  amount                Decimal              @default(0) @map("total_amount") @db.Decimal(18, 4)
  currencyCode          String               @default("KES") @map("currency_code") @db.VarChar(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId       String               @map("created_by_user_id") @db.Uuid
  metadata              Json                 @default("{}")
  reference             String?
  reversedTransactionId String?              @map("reversed_transaction_id") @db.Uuid
  status                TxnStatus            @default(DRAFT)
  type                  TxnType              @default(RETAIL)
  paymentStatus         PaymentStatus        @default(PENDING) @map("payment_status")
  system_tags           String?
  custom_tags           String?
  // Relations
  paymentApplications   PaymentApplication[]
  lines                 TransactionLine[]
  proofs                 Proof[] @relation("TransactionProof")
  // Legacy relations
  createdBy             User                 @relation("TransactionCreator", fields: [createdByUserId], references: [id])
  entity                Entity?              @relation("TransactionEntity", fields: [entityId], references: [id])
  reversedTransaction   Transaction?         @relation("LegacyTransactionReversal", fields: [reversedTransactionId], references: [id])
  reversingTransactions Transaction[]        @relation("LegacyTransactionReversal")
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  // Universal Truth relations
  fromAccount            Account?             @relation("AccountDebits", fields: [fromAccountId], references: [id])
  toAccount              Account?             @relation("AccountCredits", fields: [toAccountId], references: [id])
  reason                TransactionReason?   @relation("TransactionReasonRelation", fields: [reasonId], references: [id])
  reversal              Transaction?         @relation("UniversalTransactionReversal", fields: [reversalId], references: [id])
  reversingUniversalTransactions Transaction[] @relation("UniversalTransactionReversal")

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([tenantId, entityId])
  @@index([tenantId, type])
  @@index([paymentStatus])
  @@index([reversedTransactionId])
  @@index([status, type])
  @@index([tenantId, currencyCode])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, date])
  @@index([tenantId, fromAccountId])
  @@index([tenantId, toAccountId])
  @@index([tenantId, reasonId])
  @@map("transactions")
}

model Item {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  sku              String            @unique
  name             String
  description      String?
  itemType         String            @map("item_type")
  category         String?
  unit_of_measure  String            @default("PCS")
  defaultPrice     Decimal           @db.Decimal(18, 4)
  costPrice        Decimal?          @map("cost_price") @db.Decimal(18, 4)
  price_tiers      Json              @default("{}")
  quantity         Decimal?          @map("current_stock") @db.Decimal(12, 4)
  minQuantity      Decimal?          @map("min_stock_level") @db.Decimal(12, 4)
  reorderPoint     Decimal?          @map("reorder_point") @db.Decimal(12, 4)
  lastStockUpdate  DateTime?         @map("last_stock_update") @db.Timestamptz(6)
  supplierId       String?           @map("supplier_id") @db.Uuid
  isPerishable     Boolean           @default(false) @map("is_perishable")
  storageReq       String?           @map("storage_requirements")
  tags             String
  metadata         Json              @default("{}")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant                  @relation(fields: [tenantId], references: [id])
  transactionLines TransactionLine[]      @relation("ItemLines")
  containerItems   InventoryContainerItem[]

  @@unique([tenantId, sku])
  @@index([quantity, minQuantity])
  @@index([supplierId])
  @@index([tenantId, itemType])
  @@map("items")
}

model InventoryContainer {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  name              String
  type              String                  @map("container_type") // WAREHOUSE, BIN, SHELF, SHIPMENT, VEHICLE, etc.
  location          String?
  capacity          String?                 // optional, e.g. "100 units" or JSON
  assignedEntityId  String?                 @map("assigned_entity_id") @db.Uuid
  metadata          Json                    @default("{}")
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  assignedEntity    Entity?                 @relation(fields: [assignedEntityId], references: [id])
  items             InventoryContainerItem[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([assignedEntityId])
  @@map("inventory_containers")
}

model InventoryContainerItem {
  id           String              @id @default(uuid()) @db.Uuid
  containerId  String              @map("container_id") @db.Uuid
  itemId       String              @map("item_id") @db.Uuid
  quantity     Decimal             @db.Decimal(12, 4)
  batchRef     String              @default("") @map("batch_ref")
  expiryAt     DateTime?           @map("expiry_at") @db.Timestamptz(6)
  metadata     Json                @default("{}")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  container    InventoryContainer  @relation(fields: [containerId], references: [id], onDelete: Cascade)
  item         Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([containerId, itemId, batchRef])
  @@index([containerId, itemId])
  @@index([containerId])
  @@index([itemId])
  @@map("inventory_container_items")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String
  tenantId     String        @map("tenant_id") @db.Uuid
  displayName  String        @map("display_name")
  phoneNumber  String?       @map("phone_number")
  role         String?       @default("USER")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  metadata     Json          @default("{}")
  entities     Entity[]      @relation("EntityCreator")
    transactions   Transaction[] @relation("TransactionCreator")
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("users")
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  amount          Decimal              @db.Decimal(18, 4)
  reference       String?
  method          String?
  status          String               @default("PENDING")
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt          DateTime?            @map("paid_at") @db.Timestamptz(6)
  applications    PaymentApplication[]
  tenant          Tenant               @relation(fields: [tenantId], references: [id])

  @@map("payments")
}

model PaymentApplication {
  id            String      @id @default(uuid()) @db.Uuid
  paymentId     String      @map("payment_id") @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  amount        Decimal     @db.Decimal(18, 4)
  appliedAmount Decimal     @map("applied_amount") @db.Decimal(18, 4)
  appliedAt     DateTime    @default(now()) @map("applied_at") @db.Timestamptz(6)
  payment       Payment     @relation(fields: [paymentId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@map("payment_applications")
}

model TransactionLine {
  id              String      @id @default(uuid()) @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  itemId          String?     @map("item_id") @db.Uuid
  description     String
  quantity        Decimal     @default(1) @db.Decimal(18, 4)
  unitPrice       Decimal     @map("unit_price") @db.Decimal(18, 4)
  lineTotal       Decimal     @map("line_total") @db.Decimal(18, 4)
  totalLineAmount Decimal     @map("total_line_amount") @db.Decimal(18, 4)
  accountCode     String?     @map("account_code")
  sku             String?
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  item            Item?       @relation("ItemLines", fields: [itemId], references: [id])
  transaction     Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_lines")
}

model MoneyMovement {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  transactionId    String?   @map("transaction_id") @db.Uuid
  movementType     String    @map("movement_type")
  sourceType       String    @map("source_type")
  amount           Decimal   @db.Decimal(18, 4)
  referenceNumber  String?   @map("reference_number")
  businessPurpose  String?   @map("business_purpose")
  description      String?
  isSettled        Boolean   @default(false) @map("is_settled")
  settledDate      DateTime? @map("settled_date") @db.Timestamptz(6)
  settlementMethod String?   @map("settlement_method")
  tags             String    @map("tags")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, referenceNumber])
  @@index([tenantId, transactionId])
  @@index([movementType, sourceType])
  @@index([isSettled, settledDate])
  @@map("money_movements")
}

model TenantIntegration {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  provider        String
  integrationType String   @map("integration_type")
  credentials     Json     @default("{}")
  encryptedConfig Json     @default("{}") @map("encrypted_config")
  isActive        Boolean  @default(true) @map("is_active")
  settings        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@unique([tenantId, integrationType])
  @@map("tenant_integrations")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  key         String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  rollout     Int      @default(0)
  metadata    Json     @default("{}")
  tiers       Json     @default("[]")
  countries   Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  source          String
  eventType       String    @map("event_type")
  integrationType String    @map("integration_type")
  payload         Json      @default("{}")
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  retryCount      Int       @default(0) @map("retry_count")
  error           String?
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, source, processed])
  @@map("webhook_events")
}

model StandardTag {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  category        String   @map("category")
  tagName         String   @map("tag_name")
  tagValue        String   @map("tag_value")
  colorCode       String?  @map("color_code")
  isSystemDefined Boolean  @default(true) @map("is_system_defined")
  parentTagId     String?  @map("parent_tag_id") @db.Uuid
  isLocalRelevant Boolean  @default(false) @map("is_local_relevant")
  usageCount      Int?     @map("usage_count")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, category])
  @@index([isSystemDefined])
  @@index([isLocalRelevant])
  @@index([parentTagId])
  @@map("standard_tags")
}

model TaggingRule {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  ruleName        String   @map("rule_name")
  conditions      Json     @map("conditions")
  actions         Json     @map("actions")
  confidenceScore Int?     @map("confidence_score")
  patternExamples Json     @map("pattern_examples")
  matchCount      Int?     @map("match_count")
  successRate     Decimal? @map("success_rate") @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, isActive])
  @@map("tagging_rules")
}

model TransactionTag {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  tagId           String   @map("tag_id") @db.Uuid
  tagSource       String   @default("AUTO") @map("tag_source")
  confidenceScore Int?     @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([transactionId, tagId])
  @@index([tagSource])
  @@map("transaction_tags")
}

enum TxnStatus {
  DRAFT
  POSTED
  REVERSED
  RECONCILED
  VOIDED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  SETTLED
  FAILED
  CANCELLED
}

enum TxnType {
  RETAIL
  SERVICE
  RENTAL
  EXPENSE
}

enum EntityType {
  CUSTOMER
  SUPPLIER
  BOTH
  PARTNER
  EMPLOYEE
  AGENT
  VENDOR
  GOVERNMENT
  BANK
  CHAMA_MEMBER
}

// Universal Truth Models

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  name              String
  type              String   // CASH, BANK, AGENT, INVENTORY, FX_FLOAT, CLEARING, TRUST
  balance           Decimal  @default(0) @db.Decimal(18, 4)
  currency          String   @default("KES") @db.VarChar(3)
  metadata          Json     @default("{}")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  debitTransactions  Transaction[] @relation("AccountDebits")
  creditTransactions Transaction[] @relation("AccountCredits")

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("accounts")
}

model TransactionReason {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  type        String   // INCOME, EXPENSE, TRANSFER, ADJUSTMENT
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  parent         TransactionReason? @relation("ReasonHierarchy", fields: [parentId], references: [id])
  children       TransactionReason[] @relation("ReasonHierarchy")
  transactions   Transaction[] @relation("TransactionReasonRelation")

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("transaction_reasons")
}

model Proof {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  type          String   // RECEIPT, INVOICE, SWIFT, UPLOAD, WHATSAPP, SCREENSHOT
  reference     String?
  metadata      Json     @default("{}")
  filePath      String?  @map("file_path")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  transaction   Transaction @relation("TransactionProof", fields: [transactionId], references: [id])

  @@index([tenantId, transactionId])
  @@index([tenantId, type])
  @@map("proofs")
}
