generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enhanced Entity Model for Nairobi Business Realities
model Entity {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  displayName          String        @map("display_name")
  phoneNumber          String?       @map("phone_number")
  email                String?
  metadata             Json          @default("{}")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId       String        @map("created_by_user_id") @db.Uuid
  
  // Nairobi business flexibility (NEW)
  entityType           EntityType     @default(CUSTOMER) // CUSTOMER, SUPPLIER, PARTNER, EMPLOYEE, AGENT, VENDOR, GOVERNMENT, BANK, CHAMA_MEMBER
  businessRegistration  String?       @map("business_registration") // INFORMAL, REGISTERED, COMPANY, CHAMA, SOLE_PROPRIETOR
  businessScale         String?       @map("business_scale") // MICRO, SMALL, MEDIUM, LARGE
  registrationNumber     String?       @map("registration_number") // Business registration or tax ID
  
  // Credit management (critical for informal economy)
  creditLimit          Decimal?      @map("credit_limit")
  paymentTerms         Int?           @map("payment_terms") // Net days
  trustScore           Int?           @map("trust_score") // 0-100 from payment history
  
  // Nairobi-specific context (NEW)
  preferredContactMethod String?   @map("preferred_contact_method") // PHONE, WHATSAPP, SMS, EMAIL
  languagePreference    String?   @map("language_preference") // en, sw
  locationNotes        String?   @map("location_notes") // Market, estate, neighborhood
  
  // Smart tagging foundation (NEW)
  systemTags           String     @map("system_tags") // Predefined Nairobi business tags
  customTags          String     @map("custom_tags") // User-defined innovation tags
  businessContext       Json       @default("{}") @map("business_context") // Store relationship specifics
  
  createdBy           User          @relation("EntityCreator", fields: [createdByUserId], references: [id])
  transactions        Transaction[] @relation("TransactionEntity")
  
  @@unique([tenantId, phoneNumber])
  @@index([tenantId, entityType])
  @@map("entities")
}

// Enhanced Transaction Model with Business Context
model Transaction {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  entityId              String?              @map("entity_id") @db.Uuid
  totalAmount           Decimal              @default(0) @map("total_amount") @db.Decimal(18, 4)
  currencyCode          String               @default("KES") @map("currency_code") @db.VarChar(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId       String               @map("created_by_user_id") @db.Uuid
  metadata              Json                 @default("{}")
  reference             String?
  reversedTransactionId String?              @map("reversed_transaction_id") @db.Uuid
  status                TxnStatus            @default(DRAFT)
  type                  TxnType              @default(RETAIL)
  paymentStatus         PaymentStatus        @default(PENDING) @map("payment_status")
  paymentApplications   PaymentApplication[]
  lines                 TransactionLine[]
  createdBy             User                 @relation("TransactionCreator", fields: [createdByUserId], references: [id])
  entity                Entity?              @relation("TransactionEntity", fields: [entityId], references: [id])
  reversedTransaction   Transaction?         @relation("TransactionReversal", fields: [reversedTransactionId], references: [id])
  reversingTransactions Transaction[]        @relation("TransactionReversal")

  // Money movement context (NEW - critical for Nairobi SMEs)
  transactionChannel      String?     @map("transaction_channel") // WALK_IN, PHONE_ORDER, WHATSAPP, MPESA, USSD, BANK
  businessPurpose        String?     @map("business_purpose") // RENT, SALARIES, INVENTORY, MARKETING, TRANSPORT
  customerSegment       String?     @map("customer_segment") // WALK_IN, WHOLESALE, TOURIST, CORPORATE
  marketDayType        String?     @map("market_day_type") // NORMAL, HOLIDAY, MARKET_DAY, RAINY_DAY
  locationGps          String?     @map("location_gps") // GPS coordinates
  locationDescription     String?     @map("location_description") // "Kibuye Market", "Eastleigh", "Kawangware"
  paymentConfirmedVia    String?     @map("payment_confirmed_via") // PHONE_VERIFICATION, RECEIPT, WITNESS
  businessNotes         String?     @map("business_notes") // Free text for context

  // Smart tagging foundation (NEW)
  systemTags           String     @map("system_tags") // Predefined Nairobi business tags
  customTags          String     @map("custom_tags") // User-defined innovation tags

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([entityId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([reference])
  @@index([createdAt])
  @@map("transactions")
}

// Money Movement Tracking (NEW - Critical for Nairobi SMEs)
model MoneyMovement {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  transactionId   String?              @map("transaction_id") @db.Uuid
  movementType    String               @map("movement_type") // INFLOW, OUTFLOW, TRANSFER
  sourceType      String               @map("source_type") // CASH, MPESA, BANK, MOBILE_MONEY, CREDIT
  amount          Decimal              @db.Decimal(18,4)
  referenceNumber String?              @map("reference_number")
  businessPurpose String?               @map("business_purpose") // SALES, RENT, SALARIES, INVENTORY, TRANSPORT
  description     String?
  isSettled      Boolean              @default(false) @map("is_settled")
  settledDate     DateTime?            @map("settled_date") @db.Timestamptz(6)
  settlementMethod String?               @map("settlement_method") // CASH_HANDOVER, BANK_DEPOSIT, MOBILE_TRANSFER
  tags            String     @map("tags")
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@unique([tenantId, referenceNumber])
  @@index([tenantId, transactionId])
  @@index([movementType, sourceType])
  @@index([isSettled, settledDate])
  @@map("money_movements")
}

// Universal Item Catalog for Nairobi SMEs
model Item {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  sku             String               @unique
  name            String               
  description     String?
  itemType        String               @map("item_type") // PRODUCT, SERVICE, ASSET, EXPENSE, TAX, FEE, MATERIAL
  category        String?
  unitOfMeasure  String               @default("PCS") @map("unit_of_measure")
  defaultPrice    Decimal              @db.Decimal(18,4)
  costPrice      Decimal?             @map("cost_price") @db.Decimal(18,4)
  priceTiers      Json                 @default("{}") @map("price_tiers") // {"retail": 50, "wholesale": 45, "bulk": 40}
  currentStock    Decimal?             @map("current_stock") @db.Decimal(12,4)
  minStockLevel   Decimal?             @map("min_stock_level") @db.Decimal(12,4)
  reorderPoint    Decimal?             @map("reorder_point") @db.Decimal(12,4)
  lastStockUpdate DateTime?            @map("last_stock_update") @db.Timestamptz(6)
  supplierId      String?               @map("supplier_id") @db.Uuid
  isPerishable   Boolean              @default(false) @map("is_perishable") // Important for food businesses
  storageReq      String?               @map("storage_requirements") // "Keep dry", "Refrigerate"
  tags            String     @map("tags")
  metadata        Json                 @default("{}")
  isActive       Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@unique([tenantId, sku])
  @@index([tenantId, itemType])
  @@index([currentStock, minStockLevel])
  @@index([supplierId])
  @@map("items")
}

// Smart Tagging System for Nairobi SMEs
model StandardTag {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  category        String               @map("category") // CUSTOMER_TYPES, BUSINESS_CATEGORIES, PAYMENT_METHODS, LOCATIONS
  tagName         String               @map("tag_name")
  tagValue        String               @map("tag_value")
  colorCode       String?               @map("color_code") // For UI visualization
  isSystemDefined Boolean              @default(true) @map("is_system_defined") // Predefined vs user-created
  parentTagId     String?               @map("parent_tag_id") @db.Uuid
  isLocalRelevant Boolean              @default(false) @map("is_local_relevant") // Specific to Kenyan business context
  usageCount      Int?                 @map("usage_count") // Popularity ranking
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@index([tenantId, category])
  @@index([isSystemDefined])
  @@index([isLocalRelevant])
  @@index([parentTagId])
  @@map("standard_tags")
}

// Auto-Tagging Rules Engine for Smart Learning
model TaggingRule {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  ruleName        String               @map("rule_name")
  conditions      Json                 @map("conditions") // {"description_contains": "rent", "amount_gt": 5000, "entity_type": "SUPPLIER"}
  actions         Json                 @map("actions") // {"add_tags": ["RENT", "FIXED_EXPENSE"], "set_category": "OFFICE_COSTS"}
  confidenceScore Int?                 @map("confidence_score") // 0-100 how certain we are
  patternExamples Json                 @map("pattern_examples") // Learning examples
  matchCount      Int?                 @map("match_count") // How often it applies
  successRate     Decimal?             @map("success_rate") @db.Decimal(5,2) // How accurate predictions are
  isActive       Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  @@index([tenantId, isActive])
  @@map("tagging_rules")
}

// Transaction Tag Assignments for Learning System
model TransactionTag {
  id             String               @id @default(uuid()) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  tagId          String               @map("tag_id") @db.Uuid
  tagSource      String               @default("AUTO") @map("tag_source") // AUTO, MANUAL, SYSTEM, IMPORT
  confidenceScore Int?                 @map("confidence_score") // 0-100 accuracy
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@index([transactionId, tagId])
  @@index([tagSource])
  @@map("transaction_tags")
}

// Keep existing models (unchanged for now)
enum TxnStatus {
  DRAFT
  POSTED
  REVERSED
  RECONCILED
  VOIDED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  SETTLED
  FAILED
  CANCELLED
}

enum TxnType {
  RETAIL
  SERVICE
  RENTAL
  EXPENSE
}

enum EntityType {
  CUSTOMER
  SUPPLIER
  BOTH
  PARTNER
  EMPLOYEE
  AGENT
  VENDOR
  GOVERNMENT
  BANK
  CHAMA_MEMBER
}