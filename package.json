{
  "name": "project-bridge",
  "version": "1.0.0",
  "description": "African Informal Economy Ledger - Headless Truth Ledger",
  "private": true,
  "scripts": {
    "dev": "npx concurrently \"npm:dev:api\" \"npm:dev:web\" --names \"API,WEB\" --prefix-colors \"blue,green\"",
    "dev:api": "cd api && npm run start:dev",
    "dev:web": "cd web/my-app && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd api && npm run build",
    "build:web": "cd web/my-app && npm run build",
    "test": "npm run test:api && npm run test:web",
    "test:api": "cd api && npm run test",
    "test:web": "cd web/my-app && npm test",
    "test:integration": "jest --runInBand tests/integration/ --detectOpenHandles",
    "lint": "cd api && npm run lint && cd ../web/my-app && npm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "setup": "npm install && cd api && npm install && cd ../web/my-app && npm install",
    "clean": "rm -rf api/dist web/my-app/.next",
    "tunnel": "npx ngrok http 3001",
    "tunnel:api": "npx ngrok http 3000",
    "health-check": "node scripts/health-check.js",
    "verify-phase3": "node scripts/verify-phase3.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-proto": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "@supabase/supabase-js": "^2.0.0",
    "@traceloop/instrumentation-openai": "^0.14.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
