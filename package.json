{
  "name": "project-bridge",
  "version": "1.0.0",
  "description": "African Informal Economy Ledger - Headless Truth Ledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@project-bridge/api",
    "dev:web": "turbo run dev --filter=@project-bridge/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "jest --runInBand tests/integration/ --detectOpenHandles",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "setup": "npm install && npm run generate && npm run build",
    "generate": "turbo run generate",
    "clean": "turbo run clean && rm -rf node_modules",
    "tunnel": "npx ngrok http 3001",
    "tunnel:api": "npx ngrok http 3000"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "turbo": "^1.11.0",
    "typescript": "^5.1.3",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.8.0"
}
