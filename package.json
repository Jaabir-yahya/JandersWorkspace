{
  "name": "project-bridge",
  "version": "1.0.0",
  "description": "African Informal Economy Ledger - Headless Truth Ledger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@project-bridge/api",
    "dev": "turbo run dev",
    "dev:app": "concurrently -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "turbo run dev --filter=@project-bridge/api",
    "dev:web": "turbo run dev --filter=ledger-system-frontend",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@project-bridge/api",
    "test:integration": "npm run test:integration --workspace=@project-bridge/tests",
    "test:integration:core": "npm run test:integration --workspace=@project-bridge/tests -- --testPathPattern=core-api",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:local": "docker-compose up -d",
    "db:studio": "turbo run studio",
    "db:migrate": "turbo run migrate",
    "db:seed": "node scripts/db-seed-ke.js",
    "deploy:prod": "railway up --environment production"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.0",
    "jest": "^29.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.0.0",
    "turbo": "^1.11.0",
    "typescript": "^5.1.3",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "supabase": "^2.74.5"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@9.8.0"
}