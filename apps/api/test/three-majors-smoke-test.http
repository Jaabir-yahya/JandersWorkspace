### Three Majors Smoke Test
### This file tests RETAIL, SERVICE, and RENTAL transactions via the NestJS API

@baseUrl = http://localhost:3000/api/v1
@tenantId = 22222222-2222-2222-2222-222222222222
@entityId = 11111111-1111-1111-1111-111111111111
@userId = 33333333-3333-3333-3333-333333333333

###
# 1. RETAIL Transaction - Sale of Goods
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "tenant_id": "{{tenantId}}",
  "entity_id": "{{entityId}}",
  "created_by_user_id": "{{userId}}",
  "type": "RETAIL",
  "currency_code": "KES",
  "reference": "INV-RETAIL-001",
  "lines": [
    {
      "description": "Nike Shoes",
      "sku": "NIKE-001",
      "quantity": 2,
      "unit_price": 5000,
      "account_code": "200-SALES",
      "metadata": {
        "variant": "Size 40",
        "stock_location": "Shelf A",
        "weight_kg": 1.2
      }
    },
    {
      "description": "Adidas Jacket",
      "sku": "ADIDAS-002",
      "quantity": 1,
      "unit_price": 8000,
      "account_code": "200-SALES",
      "metadata": {
        "variant": "Medium",
        "color": "Black"
      }
    }
  ]
}

###
# 2. SERVICE Transaction - Sale of Time/Talent
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "tenant_id": "{{tenantId}}",
  "entity_id": "{{entityId}}",
  "created_by_user_id": "{{userId}}",
  "type": "SERVICE",
  "currency_code": "KES",
  "reference": "INV-SERVICE-001",
  "lines": [
    {
      "description": "DJ Consultation",
      "quantity": 4,
      "unit_price": 2500,
      "account_code": "300-SERVICE-INCOME",
      "metadata": {
        "hours": 4,
        "project_code": "PROJ-001",
        "start_time": "18:00",
        "end_time": "22:00",
        "skill_level": "Senior"
      }
    }
  ]
}

###
# 3. RENTAL Transaction - Hire of Assets
POST {{baseUrl}}/transactions
Content-Type: application/json

{
  "tenant_id": "{{tenantId}}",
  "entity_id": "{{entityId}}",
  "created_by_user_id": "{{userId}}",
  "type": "RENTAL",
  "currency_code": "KES",
  "reference": "INV-RENTAL-001",
  "lines": [
    {
      "description": "Canon EOS Camera",
      "quantity": 7,
      "unit_price": 1500,
      "account_code": "400-RENTAL-INCOME",
      "metadata": {
        "return_date": "2024-02-15",
        "serial_number": "SN-998877",
        "deposit_held": 5000,
        "condition_out": "New",
        "insurance_waiver": true
      }
    }
  ]
}

###
# 4. List all transactions for tenant
GET {{baseUrl}}/transactions?tenant_id={{tenantId}}

###
# 5. List only RETAIL transactions
GET {{baseUrl}}/transactions?tenant_id={{tenantId}}&type=RETAIL

###
# 6. Get specific transaction (replace ID after creating one)
# GET {{baseUrl}}/transactions/<transaction-id>

###
# 7. Get transactions by entity
GET {{baseUrl}}/transactions/entity/{{entityId}}
