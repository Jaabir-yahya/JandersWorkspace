generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  phoneNumber         String        @map("phone_number")
  email               String?
  displayName         String?       @map("display_name")
  role                String?
  metadata            Json          @default("{}")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdEntities     Entity[]      @relation("EntityCreator")
  createdPayments     Payment[]     @relation("PaymentCreator")
  createdTransactions Transaction[] @relation("TransactionCreator")

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("users")
}

model Entity {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  displayName     String        @map("display_name")
  phoneNumber     String?       @map("phone_number")
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  type            EntityType
  createdBy       User          @relation("EntityCreator", fields: [createdByUserId], references: [id])
  transactions    Transaction[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("entities")
}

model Transaction {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  entityId              String?              @map("entity_id") @db.Uuid
  totalAmount           Decimal              @default(0) @map("total_amount") @db.Decimal(18, 4)
  currencyCode          String               @default("KES") @map("currency_code") @db.VarChar(3)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId       String               @map("created_by_user_id") @db.Uuid
  metadata              Json                 @default("{}")
  reference             String?
  reversedTransactionId String?              @map("reversed_transaction_id") @db.Uuid
  status                TxnStatus            @default(DRAFT)
  type                  TxnType              @default(RETAIL)
  paymentStatus         PaymentStatus        @default(PENDING) @map("payment_status")
  paymentApplications   PaymentApplication[]
  lines                 TransactionLine[]
  createdBy             User                 @relation("TransactionCreator", fields: [createdByUserId], references: [id])
  entity                Entity?              @relation(fields: [entityId], references: [id])
  reversedTransaction   Transaction?         @relation("TransactionReversal", fields: [reversedTransactionId], references: [id])
  reversingTransactions Transaction[]        @relation("TransactionReversal")

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
  @@index([entityId, createdAt])
  @@index([tenantId, paymentStatus])
  @@index([reference])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionLine {
  id              String      @id @default(uuid()) @db.Uuid
  transactionId   String      @map("transaction_id") @db.Uuid
  description     String?
  quantity        Decimal     @default(1.0) @db.Decimal(18, 4)
  unitPrice       Decimal     @map("unit_price") @db.Decimal(18, 4)
  totalLineAmount Decimal     @map("total_line_amount") @db.Decimal(18, 4)
  accountCode     String      @map("account_code")
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  sku             String?
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountCode])
  @@index([sku])
  @@map("transaction_lines")
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  reference       String?
  amount          Decimal              @db.Decimal(18, 4)
  currencyCode    String               @default("KES") @map("currency_code") @db.VarChar(3)
  status          PaymentStatus        @default(PENDING)
  metadata        Json                 @default("{}")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  applications    PaymentApplication[]
  createdBy       User                 @relation("PaymentCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([reference])
  @@index([createdAt])
  @@map("payments")
}

model PaymentApplication {
  id            String      @id @default(uuid()) @db.Uuid
  paymentId     String      @map("payment_id") @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  appliedAmount Decimal     @map("applied_amount") @db.Decimal(18, 4)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([paymentId, transactionId])
  @@index([transactionId])
  @@index([paymentId])
  @@map("payment_applications")
}

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  tier        String
  country     String
  isActive    Boolean   @default(true) @map("is_active")
  settings    Json      @default("{}")
  apiKeyHash  String?   @map("api_key_hash") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug])
  @@index([country])
  @@map("tenants")
}

model TenantIntegration {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  integrationType String    @map("integration_type")
  encryptedConfig Json      @map("encrypted_config")
  isActive        Boolean   @default(true) @map("is_active")
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz(6)
  syncStatus      String    @default("PENDING") @map("sync_status")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, integrationType])
  @@index([tenantId])
  @@index([integrationType])
  @@map("tenant_integrations")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  tiers       String[]
  countries   String[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@index([isActive])
  @@map("feature_flags")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  integrationType String    @map("integration_type")
  eventType       String    @map("event_type")
  payload         Json
  processed       Boolean   @default(false)
  retryCount      Int       @default(0) @map("retry_count")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([tenantId, processed])
  @@index([createdAt])
  @@index([processed])
  @@map("webhook_events")
}

model ExternalReference {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  localId        String    @map("local_id")
  localType      String    @map("local_type")
  externalSystem String    @map("external_system")
  externalId     String    @map("external_id")
  externalData   Json      @map("external_data")
  syncDirection  String    @map("sync_direction")
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, localId, localType, externalSystem])
  @@index([tenantId])
  @@index([externalSystem])
  @@index([externalId])
  @@index([localType])
  @@map("external_references")
}

enum TxnStatus {
  DRAFT
  POSTED
  REVERSED
  RECONCILED
  VOIDED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  SETTLED
  FAILED
  CANCELLED
}

enum TxnType {
  RETAIL
  SERVICE
  RENTAL
  EXPENSE
}

enum EntityType {
  CUSTOMER
  SUPPLIER
  BOTH
}
