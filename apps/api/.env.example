# ============================================
# Project Bridge API - Environment Variables
# ============================================

# --------------------------------------------
# Database (Supabase PostgreSQL)
# --------------------------------------------
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# DATABASE_URL: Use port 5432 (Transaction pooler) for migrations
# DIRECT_URL: Use port 6543 (Session pooler with pgbouncer) for app queries

DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# --------------------------------------------
# Supabase (NEW API Keys - Not Legacy)
# --------------------------------------------
# Get from: Supabase Dashboard → Project Settings → API → Project URL & API Keys
# Use the NEW "Secret API key" (NOT the legacy "service_role" key)

SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --------------------------------------------
# Security
# --------------------------------------------
# Generate strong random strings for these

JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# --------------------------------------------
# CORS (Frontend URLs)
# --------------------------------------------
# Comma-separated list of allowed frontend origins.
# Railway (production): add your Vercel frontend URL exactly as the browser sends it.
# Local: add the URL your frontend runs on (e.g. http://localhost:3000 if web dev is on 3000).

ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://your-app.vercel.app"

# --------------------------------------------
# M-Pesa Integration (Optional - for dogfood tenant)
# --------------------------------------------
# Get from: Safaricom Developer Portal (https://developer.safaricom.co.ke)

MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://your-api.railway.app/api/v1/integrations/mpesa/stk-callback"

# --------------------------------------------
# WhatsApp Integration (Optional - for dogfood tenant)
# --------------------------------------------
# Get from: Meta Developer Portal (https://developers.facebook.com)

WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token"

# --------------------------------------------
# QuickBooks Integration (Optional)
# --------------------------------------------
QUICKBOOKS_CLIENT_ID="your-client-id"
QUICKBOOKS_CLIENT_SECRET="your-client-secret"
QUICKBOOKS_REDIRECT_URI="https://your-api.railway.app/api/v1/integrations/quickbooks/callback"

# --------------------------------------------
# Xero Integration (Optional)
# --------------------------------------------
XERO_CLIENT_ID="your-client-id"
XERO_CLIENT_SECRET="your-client-secret"
XERO_REDIRECT_URI="https://your-api.railway.app/api/v1/integrations/xero/callback"

# --------------------------------------------
# Shopify Integration (Optional)
# --------------------------------------------
SHOPIFY_API_KEY="your-api-key"
SHOPIFY_API_SECRET="your-api-secret"
SHOPIFY_REDIRECT_URI="https://your-api.railway.app/api/v1/integrations/shopify/callback"

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# API runs on 3001 so Next.js web app can use 3000
PORT=3001
NODE_ENV="development"
